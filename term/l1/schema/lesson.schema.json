{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Math Inquirers Level 1 term-time lesson (schema_version 1)",
  "description": "One lesson = one JSON file in term/l1/lessons/lNN.json. tools/validate.py enforces the rules that JSON Schema cannot (timing sums, slide/script links, wording, answers). Line kinds in script: SAY READ ASK DO SLIDE WORK HOLD MOVE REC (timed), STUCK NOTE (untimed). Block types in slides: chip p list card visual qs answers say cols table numrow answer lookback.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "level",
    "term",
    "lesson",
    "lesson_in_term",
    "title",
    "big_idea",
    "child_idea",
    "skill",
    "moe",
    "objectives",
    "joining_cold",
    "materials",
    "timing",
    "sneak_peek",
    "rec",
    "script",
    "slides",
    "tiers",
    "talk",
    "exit",
    "look_back",
    "home_practice",
    "online_practice",
    "parent",
    "safeguarding",
    "tutor_prep",
    "spare_time"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "description": "l1-t{term}-{NN}"
    },
    "level": {
      "const": 1
    },
    "term": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "lesson": {
      "type": "integer",
      "description": "1-40 over the year"
    },
    "lesson_in_term": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "title": {
      "type": "string"
    },
    "big_idea": {
      "type": "string"
    },
    "child_idea": {
      "type": "string",
      "description": "one or two child-sized sentences"
    },
    "skill": {
      "type": "string"
    },
    "ages": {
      "type": "string"
    },
    "moe": {
      "type": "object",
      "required": [
        "strand",
        "topics",
        "note"
      ],
      "properties": {
        "strand": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "contest_moves": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "tutor-only; these sit at Think harder, never Start here"
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "joining_cold": {
      "type": "object",
      "required": [
        "remember",
        "assumes",
        "note"
      ],
      "properties": {
        "remember": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumes": {
          "type": "string"
        },
        "holiday_topics_revisited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safe_to_miss": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "materials": {
      "type": "object",
      "required": [
        "child",
        "tutor",
        "ruler",
        "notes"
      ],
      "properties": {
        "child": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tutor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kit_pages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ruler": {
          "type": "boolean",
          "description": "true only if the child has a printed or real ruler at home"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "parts",
        "optional_slide"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "start",
              "end"
            ],
            "properties": {
              "id": {
                "enum": [
                  "opening",
                  "remember",
                  "sneak",
                  "explore",
                  "mini",
                  "break",
                  "work",
                  "talk",
                  "exit",
                  "look",
                  "flex"
                ]
              },
              "title": {
                "type": "string"
              },
              "start": {
                "type": "integer"
              },
              "end": {
                "type": "integer"
              }
            }
          },
          "description": "contiguous, from 0, summing to exactly 90, last part is flex (>= 4 min)"
        },
        "optional_slide": {
          "type": "string"
        },
        "include_rules": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sneak_peek": {
      "type": "object",
      "required": [
        "q1",
        "q2",
        "a1",
        "a2"
      ],
      "description": "q1 is an access question (objects, drawing or counting); q2 a thinking question"
    },
    "rec": {
      "type": "object",
      "description": "per part id: {say (max 26 words), action}",
      "additionalProperties": {
        "type": "object",
        "required": [
          "say",
          "action"
        ]
      }
    },
    "script": {
      "type": "object",
      "required": [
        "segments"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "part",
              "lines"
            ],
            "properties": {
              "part": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/line"
                }
              }
            }
          }
        }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "part",
          "kind",
          "title",
          "blocks",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "part": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "title",
              "light",
              "dark",
              "lookback"
            ]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          },
          "blocks": {
            "type": "array"
          },
          "note": {
            "type": "string",
            "description": "speaker note, at least 12 words"
          }
        }
      }
    },
    "tiers": {
      "type": "object",
      "required": [
        "start",
        "think",
        "go",
        "investigation"
      ],
      "properties": {
        "start": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          },
          "description": "5 to 8 questions on workbook pages 1 and 2; core, approachable, untaught or just explored"
        },
        "think": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          },
          "description": "3 to 5; a taught idea in a new setting; contest-style moves live here"
        },
        "go": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          },
          "description": "exactly 3; mastery plus extension"
        },
        "investigation": {
          "type": "object",
          "required": [
            "id",
            "title",
            "first",
            "text",
            "answer",
            "look_for",
            "mistakes"
          ]
        }
      }
    },
    "talk": {
      "type": "object",
      "required": [
        "question",
        "starter",
        "answer",
        "look_for"
      ]
    },
    "exit": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "look_back": {
      "type": "object",
      "required": [
        "hardest",
        "helped",
        "next"
      ]
    },
    "home_practice": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "online_practice": {
      "type": "object",
      "required": [
        "key",
        "title",
        "topic",
        "items"
      ],
      "description": "items are in the practice/ runner format (type number|choice|multi|set|selfcheck; tier core|stretch|challenge; slips; tpl with vars, derive, answer using + - * // % ( ) only; a pure a//b must be the whole expression)"
    },
    "parent": {
      "type": "object",
      "required": [
        "summary",
        "words",
        "try_home",
        "ask",
        "when_stuck",
        "next",
        "report_line",
        "term_line"
      ]
    },
    "spare_time": {
      "type": "object",
      "required": [
        "note",
        "rules",
        "menu"
      ],
      "description": "If the class is ahead: 2-3 optional whole-class activities (3-5 min each; tutor line, rec cue, answer); never added to the 90-minute sum",
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 3
        },
        "menu": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "minutes",
              "tutor",
              "rec",
              "answer"
            ]
          }
        }
      }
    },
    "safeguarding": {
      "type": "array",
      "minItems": 4
    },
    "tutor_prep": {
      "type": "array"
    }
  },
  "$defs": {
    "line": {
      "type": "object",
      "required": [
        "k"
      ],
      "properties": {
        "k": {
          "enum": [
            "SAY",
            "READ",
            "ASK",
            "DO",
            "SLIDE",
            "WORK",
            "HOLD",
            "MOVE",
            "REC",
            "STUCK",
            "NOTE"
          ]
        },
        "text": {
          "type": "string",
          "description": "REC lines may be @rec = the part rec.say"
        },
        "slide": {
          "type": "string"
        },
        "s": {
          "type": "number",
          "description": "seconds (required for WORK, DO)"
        },
        "resp": {
          "type": "number",
          "description": "ASK: seconds for children to answer (default 30)"
        },
        "optional": {
          "type": "boolean"
        },
        "par": {
          "type": "boolean"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "tier",
        "text",
        "answer",
        "val",
        "hint",
        "solution",
        "mistakes",
        "mins"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "S1.. T1.. G1.."
        },
        "page": {
          "type": "integer"
        },
        "tier": {
          "enum": [
            "start",
            "think",
            "go"
          ]
        },
        "text": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "l",
              "text",
              "ans",
              "val"
            ]
          }
        },
        "visual": {
          "type": "object"
        },
        "draw": {
          "type": "boolean"
        },
        "answer": {
          "type": "string"
        },
        "val": {
          "description": "machine-checkable value(s), re-computed in verify/lNN_checks.py"
        },
        "hint": {
          "type": "string"
        },
        "solution": {
          "type": "string"
        },
        "mistakes": {
          "type": "array",
          "minItems": 1
        },
        "mins": {
          "type": "number"
        },
        "lines": {
          "type": "integer"
        }
      }
    }
  }
}