{
  // Cloudflare Workers static-assets deploy for the Math Inquirers website.
  // The built site (website/dist) already contains _headers, _redirects and 404.html.
  // worker/index.js serves the /api/* routes (downloads, order links, Stripe); everything else is the static site.
  "name": "math-inquirers",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./website/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
  // Add this ONLY after the R2 bucket "mi-delivery" exists (a binding to a missing bucket makes the deploy fail):
  // "r2_buckets": [{ "binding": "DELIVERY_BUCKET", "bucket_name": "mi-delivery" }]
}
