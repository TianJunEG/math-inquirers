   "steps": [
    "Letter numbers: Z = 25, I = 8, P = 15.",
    "Add the shift 7 to each: 32, 15 and 22.",
    "Take mod 26: 32 − 26 = 6. The numbers are 6, 15 and 22.",
    "Back to letters: 6 = G, 15 = P, 22 = W."
   ],
   "answer": "ZIP becomes GPW."
  },
  "howto": {
   "title": "How to code and decode",
   "steps": [
    "Write the letter numbers, A = 0 to Z = 25.",
    "To code, add the shift. If the total is 26 or more, take away 26.",
    "To decode, take away the shift. If the total is below 0, add 26.",
    "Change the numbers back into letters."
   ]
  },
