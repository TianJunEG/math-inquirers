  "howto": {
   "title": "How to",
   "steps": [
    "Find one angle. Write the reason.",
    "Use it to find the next angle.",
    "Check: do the angles add up?"
   ]
  },
  "facts": {
   "title": "Reasons",
   "lines": [
    "Line 180°. Point 360°. Triangle 180°.",
    "Isosceles: equal sides, equal angles.",
    "Parallelogram: opposite angles equal, neighbours 180°.",
    "Trapezium: between parallel sides 180°."
   ]
  },
