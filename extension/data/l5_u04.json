 "holiday_lesson": 4,
 "goal": "I can find the area of a triangle with the height that meets the base at a right angle. I can find areas of shapes made from triangles.",
 "learn": {
  "intro": "The area of a triangle is 1/2 × base × height. The height meets the base at a right angle. A slanting side is not the height, unless the triangle has a right angle there.",
  "example": {
   "problem": "Find the area of triangle ABC. The dashed line is the height.",
   "steps": [
    "Choose the base: AB = 21 cm. The height meets AB at a right angle: it is 8 cm.",
    "The sides AC = 10 cm and BC = 17 cm are slanting. They are not heights, so we do not use them.",
    "Area = 1/2 × base × height = 1/2 × 21 × 8.",
    "21 × 8 = 168 and half of 168 is 84."
   ],
   "answer": "The area of triangle ABC is 84 cm².",
